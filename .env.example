# ========================================================
# Team Archon Clipping Backend (VPS Configuration)
# ========================================================

PORT=4000
CLIPPING_API_KEY=your_vps_secure_secret_key_change_me

# CMS Web App Origin (for CORS)
ALLOWED_ORIGINS=https://cms.teamarchon.in,http://localhost:3000

# Public URL of the CMS Frontend (where viewers watch clips)
FRONTEND_URL=https://cms.teamarchon.in

# Public URL of this VPS backend (for webhook links & direct media)
# Set to https://api.teamarchon.in once DNS A-record points to your VPS
PUBLIC_BASE_URL=https://api.teamarchon.in

# ========================================================
# Discord Logging Webhook
# ========================================================
# Paste your Discord Channel Webhook URL here to log clips & system events:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Optional bot name and avatar customization:
DISCORD_BOT_NAME=Archon Clipping Engine
DISCORD_BOT_AVATAR=https://cms.teamarchon.in/logo.png
